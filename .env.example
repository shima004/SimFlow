# Argo Workflows server URL (e.g. https://argo.example.com)
ARGO_BASE_URL=http://localhost:2746

# Kubernetes namespace to list workflows from
ARGO_NAMESPACE=default

# Bearer token for Argo Workflows authentication (optional)
ARGO_TOKEN=

# S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Comma-separated list of buckets that clients are allowed to access
S3_ALLOWED_BUCKETS=bucket1,bucket2
